<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<workflow-app xmlns="uri:oozie:workflow:0.2" name="full-historical-load-workflow">
    <start to="start-historical-load"/>

    <action name="start-historical-load">
        <shell xmlns="uri:oozie:shell-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <exec>start_historical_load.sh</exec>
            <file>${start_historical_load_script}#start_historical_load.sh</file>
            <capture-output/>
        </shell>
        <ok to="create-staging-schema"/>
        <error to="fail"/>
    </action>

    <action name="create-staging-schema">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${create_staging_schema_hive}</script>
        </hive>
        <ok to="ingest-operational-data"/>
        <error to="fail"/>
    </action>

    <action name="ingest-operational-data">
        <shell xmlns="uri:oozie:shell-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <exec>ingest_operational_data_script.sh</exec>
            <script>${ingest_operational_data_script}#ingest_operational_data_script.sh</script>
            <capture-output/>
        </shell>
        <ok to="fork1"/>
        <error to="fail"/>
    </action>

    <fork name="fork1">
        <path start="create-master-schema"/>
        <path start="load-finwire-db"/>
    </fork>

    <action name="create-master-schema">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${create_master_schema_hive}</script>
        </hive>
        <ok to="join1"/>
        <error to="fail"/>
    </action>

    <action name="load-finwire-db">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${create_master_schema_hive}</script>
        </hive>
        <ok to="join1"/>
        <error to="fail"/>
    </action>

    <join name = "join1" to = "fork2"/>

    <fork name="fork2">
        <path start="load-master-tradetype"/>
        <path start="load-master-statustype"/>
        <path start="load-master-taxrate"/>
        <path start="load-master-industry"/>
        <path start="transform-load-master-dimdate"/>
        <path start="transform-load-master-dimtime"/>
        <path start="transform-load-master-dimcompany"/>
        <path start="transform-load-master-dimbroker"/>
    </fork>

    <action name="load-master-tradetype">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${load_master_tradetype_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="load-master-statustype">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${load_master_statustype_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="load-master-taxrate">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${load_master_taxrate_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="load-master-industry">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${load_master_industry_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="transform-load-master-dimdate">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${transform_load_master_dimdate_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="transform-load-master-dimtime">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${transform_load_master_dimtime_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="transform-load-master-dimcompany">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${transform_load_master_dimcompany_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <action name="transform-load-master-dimbroker">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${transform_load_master_dimbroker_hive}</script>
        </hive>
        <ok to="join2"/>
        <error to="fail"/>
    </action>

    <join name = "join2" to = "transform-load-master-prospect"/>

    <action name="transform-load-master-prospect">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${transform_load_master_prospect_hive}</script>
        </hive>
        <ok to="update-master-prospect"/>
        <error to="fail"/>
    </action>

    <action name="update-master-prospect">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <script>${update_master_prospect_hive}</script>
        </hive>
        <ok to="end"/>
        <error to="fail"/>
    </action>

    <kill name="fail">
        <message>Workflow failed, error message[${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>

    <end name="end"/>
</workflow-app>
