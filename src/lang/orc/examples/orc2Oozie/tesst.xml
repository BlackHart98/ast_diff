<workflow-app name="flow1" xmlns="uri:oozie:workflow:0.4">
    <start to="startHistoricalLoad"/>

    <action name="createStagingSchema">
        <hive xmlns="uri:oozie:hive-action:0.4">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <file>${create_staging_schema_hive}</file>
        </hive>
        <ok to="load_order_detail_daily"/>
        <error to="fail"/>
    </action>
    <fork name="fork1">
        <path start="transformation"/>
    </fork>

    <action name="create-master-schema">
        <hive xmlns="uri:oozie:hive-action:0.2">
            <job-tracker>${jobTracker}</job-tracker>
            <name-node>${nameNode}</name-node>
            <job-xml>hive-site.xml</job-xml>
            <script>${create_master_schema_hive}</script>
        </hive>
        <ok to="join1"/>
        <error to="fail"/>
    </action>

    <join name="join1" to="fork2">
    
    </join>


