module createtable 
  

 
@ifNotExists

         entity Dim_product extends Stg_new_product 
          
  end entity
 
   
view stg_new_product 
(view _ on Product as p
      attributes
      product_id = p.id
 p.product_code
 p.product_name
 p.description
 supplier_company = s.company
 p.standard_cost
 p.list_price
 p.reorder_level
 p.target_level
 p.quantity_per_unit
 p.discontinued
 p.minimum_reorder_quantity
 p.category
 p.attachments
 insertion_timestamp = CURRENT_TIMESTAMP()
       left outer join Supplier  as s 
  on (s.id == p.supplier_id)
 end view)
end view
 
@partitionedBy( order_date Date ) 







 
@ifNotExists

entity Fact_sales 
      order_id :Int 
      product_id :Int 
      customer_id :Int 
      employee_id :Int 
      shipper_id :Int 
      quantity :Int 
      unit_price :Float
      discount :Float 
      status_id :Int 
      date_allocated :Date 
      purchase_order_id :Int 
      inventory_id :Int 
      order_date :Date 
      shipped_date :Date 
      paid_date :Date 
      insertion_timestamp :Timestamp 
end entity