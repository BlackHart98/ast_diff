module createview 
  
@ifNotExistsview date_dimension on 
 (view _ on 
     attributes
     d = explode(split(space(DATEDIFF('2050-01-01',
'2014-01-01')),
' ')) + '2014-01-01'
      end view) as date_array 
   attributes
       id = date_format(d,
       'yyyy-MM-dd')
       full_date = d
       year = YEAR(d)
       week_start_date = FROM_UNIXTIME((UNIX_TIMESTAMP(d) - (86400 * (date_format(d,
       'u') - 1))))
       week_day = date_format(d,
       'u')
       day_name = date_format(d,
       'EEEE')
       day_is_weekday = if date_format(d,
       'u') in [6,7]  then 0 else 1
       month = date_format(d,
       'MM')
       month_name = date_format(d,
       'MMMM')
       fiscal_qtr = date_format(d,
       'Q')
       fiscal_year = YEAR(d) 
end view