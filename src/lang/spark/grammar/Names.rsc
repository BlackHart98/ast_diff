    | 'VIEW'
    | 'CREATE'
    | 'TRUE'
    | 'FALSE'
    | 'ROW'
    | 'FORMAT'
    | 'COMMENT'
    | 'ANALYZE'
    | 'ADD'
    | 'FILE'
