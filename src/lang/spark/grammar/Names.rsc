module lang::spark::grammar::Names

extend lang::spark::grammar::Literals;


lexical FUNCTIONNAME = REGULARIDENTIFIER \ IMPLEMENTED_FUNCTIONNAME;

syntax VarAssign
    = varAssignFunc: VarAssignAs? Identifier"(" {Expr ","}+ ")"
    ;

keyword Keywords
    = 'LIKE'
    | 'MATCH'
    | 'PIVOT'
    | 'AS'
    | 'SELECT'
    | 'SMALLINT'
    | 'BIGINT'
    | 'TINYINT'
    | 'STRING'
