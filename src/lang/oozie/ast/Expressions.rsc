module lang::oozie::ast::Expressions

data OozieProg 
        = ooziExps(list[OozieExpr] oexps)
        ; 
data OozieExpr 
        = immediateEval(Expr exp)
        | deferredEval(Expr exp)
        ;
data Expr
        = variable(list[str] ids)
        | integer(str \int)
        | long(str \int)
        | decimal(str decim)
        | scientificnum(str scinum)
        | string(str strConst)
        | functionlist(list[str] idOpt, list[Expr] expOpt)
        | \bracket(Expr exp)
        | uMin(Expr expr)
        | not(Expr expr)
        | logicalNot(Expr exp)
        | empty(Expr exp)
        | mul(Expr expr1, Expr expr2)
        | div(Expr expr1, Expr expr2)
        | division(Expr expr1, Expr expr2)
        | modulus(Expr expr1, Expr expr2)
        | modulo(Expr expr1, Expr expr2)
        | add(Expr expr1, Expr expr2)
        | sub(Expr expr1, Expr expr2)
        | concat(Expr expr1, Expr expr2)
        | lt(Expr expr1, Expr expr2)
        | gt(Expr expr1, Expr expr2)
        | lte(Expr expr1, Expr expr2)
        | gte(Expr expr1, Expr expr2)
        | lessThan(Expr expr1, Expr expr2)
        | greaterThan(Expr expr1, Expr expr2)
        | lessThanOrEqual(Expr expr1, Expr expr2)
        | greaterThanOrEqual(Expr expr1, Expr expr2)
        | twoEqual(Expr expr1, Expr expr2)
        | neq1(Expr expr1, Expr expr2)
        | equality(Expr expr1, Expr expr2)
        | inequality(Expr expr1, Expr expr2)
        | and(Expr expr1, Expr expr2)
        | logicalAnd(Expr expr1, Expr expr2)
        | cct(Expr expr1, Expr expr2)
        | logicalOr(Expr expr1, Expr expr2)
        | conditional(Expr condition, Expr eval1, Expr eval2)
        | lambda(Expr arg, Expr exp)
        | assign(Expr expr1, Expr expr2)
        | semicolon(Expr expr1, Expr expr2)
        | function(Expr exp, list[Expr] expOpt, list[Expr] explist)
        | commaseparated(Expr exp, list[Expr] exps)
        | colonfunction(str id, Expr exp)
        ;