module HQL 
  
 @dropIfExist  
view product 
(view _ on northwind.products 
      attributes
      supplier_id = 
 id
 product_code
 product_name
 description
 standard_cost
 list_price
 reorder_level
 target_level
 quantity_per_unit
 discontinued
 minimum_reorder_quantity
 category
 attachments
 ingestion_timestamp = currentTimeStamp()
       filter
 !supplier_ids like "%;%"
           
           
           
 end view)
end view