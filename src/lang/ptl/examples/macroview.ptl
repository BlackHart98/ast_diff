module macroview

defmacro createWildView(x)
  view #{x} on 
 
    (view _ on  Transactions 
     attributes
     *
      end view
        union all
     view _ on  HistoricalInfo 
     attributes
     *
      end view) as q 
   attributes
       viewAmount = 0
       number = 0
       kkk = 9
       ggg = l 
end view
end defmacro

createWildView!("MyView")

